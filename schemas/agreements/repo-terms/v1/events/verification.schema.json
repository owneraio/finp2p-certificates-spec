{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownera.io/certificates/agreements/repo-terms/v1/events/verification.schema.json",
  "title": "Repo Verification",
  "description": "verification/v1: the document a venue-verified event carries. The venue checks a trade's milestone independently and records what it checked. It cites the milestone event (basket-registered, trade-collateralised, execution-started or trade-settled), once per milestone. nominal checks the log alone; on-chain reads the ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verifiedEventType",
    "method",
    "result"
  ],
  "properties": {
    "verifiedEventType": {
      "type": "string",
      "enum": [
        "basket-registered",
        "trade-collateralised",
        "execution-started",
        "trade-settled"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "nominal",
        "on-chain"
      ],
      "description": "nominal: the milestone's own record on the log. on-chain: the ledger state behind it."
    },
    "result": {
      "type": "string",
      "enum": [
        "verified",
        "mismatch"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
